      { emoji: '🎵', title: 'Giai Điệu Của Em', sub: 'Bản Nhạc Ngọt Ngào', bg1: '#8b5cf6', bg2: '#5b21b6', msg: 'Giọng nói và tiếng cười của Xuka chính là bản nhạc êm dịu nhất mà anh muốn nghe mỗi ngày.' },
