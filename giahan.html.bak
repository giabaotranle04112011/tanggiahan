<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Món Quà Vũ Trụ 3D • Gửi Bé Gia Hân (Xuka) 17/03/2011</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background: #000000;
      color: #f8fafc;
      overflow: hidden;
      touch-action: none;
    }
    .font-handwriting {
      font-family: 'Dancing Script', cursive;
    }
    .glass-panel {
      background: rgba(6, 8, 18, 0.78);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 20px 55px rgba(0, 0, 0, 0.9), 0 0 28px rgba(244, 114, 182, 0.18);
    }
    .star-glow {
      text-shadow: 0 0 14px rgba(255, 255, 255, 0.9), 0 0 32px rgba(244, 114, 182, 0.85), 0 0 58px rgba(56, 189, 248, 0.55);
    }
    @keyframes pulseGlow {
      0%, 100% { transform: scale(1); box-shadow: 0 0 18px rgba(244, 114, 182, 0.55); }
      50% { transform: scale(1.04); box-shadow: 0 0 34px rgba(244, 114, 182, 0.95); }
    }
    .btn-glow {
      animation: pulseGlow 2.2s infinite ease-in-out;
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-7px); }
    }
    .animate-float {
      animation: floatSlow 3.4s ease-in-out infinite;
    }
  </style>
</head>
<body class="h-screen w-screen relative flex flex-col justify-between bg-black overflow-hidden">

  <!-- Interactive 360° 3D Sphere / Particle / Galaxy Canvas -->
  <canvas id="sky-canvas" class="fixed inset-0 w-full h-full z-0 cursor-grab active:cursor-grabbing"></canvas>

  <!-- INTRO / PASSCODE LOCK OVERLAY (DLove Style: Passcode 1703 -> Particle Intro -> 3D Photo Sphere) -->
  <div id="intro-modal" class="fixed inset-0 z-40 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md transition-opacity duration-500">
    <div class="glass-panel max-w-sm w-full rounded-3xl p-6 text-center relative overflow-hidden border border-pink-400/30">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-pink-500 via-rose-500 to-amber-300 mx-auto flex items-center justify-center shadow-lg shadow-pink-500/50 mb-3 animate-float">
        <i data-lucide="gift" class="w-7 h-7 text-white"></i>
      </div>
      <span class="inline-block px-3 py-0.5 rounded-full bg-pink-500/20 border border-pink-400/40 text-pink-200 text-[11px] font-semibold tracking-wider mb-1">
        MÓN QUÀ 3D DÀNH TẶNG XUKA • 17/03/2011
      </span>
      <h1 class="font-handwriting text-3xl sm:text-4xl font-bold text-white star-glow">
        Chào Bé Gia Hân! 💖
      </h1>
      <p class="text-xs text-slate-300 mt-1 mb-3">
        Nhập mật khẩu 4 số ngày sinh của em (<strong class="text-pink-300">1703</strong>) hoặc bấm mở quà ngay để xem hiệu ứng hạt & Quả Cầu Kỷ Niệm 3D xoay 360° nhé!
      </p>

      <!-- 4-Dot Passcode Display -->
      <div class="flex items-center justify-center gap-3 my-3">
        <span id="dot-0" class="w-3.5 h-3.5 rounded-full border-2 border-pink-400 transition-all"></span>
        <span id="dot-1" class="w-3.5 h-3.5 rounded-full border-2 border-pink-400 transition-all"></span>
        <span id="dot-2" class="w-3.5 h-3.5 rounded-full border-2 border-pink-400 transition-all"></span>
        <span id="dot-3" class="w-3.5 h-3.5 rounded-full border-2 border-pink-400 transition-all"></span>
      </div>
      <p id="pass-hint" class="text-[11px] text-rose-400 min-h-[16px] mb-2 opacity-0 transition">Mật khẩu là 1703 nha Bé Gia Hân ơi 🥰</p>

      <!-- Mini Keypad -->
      <div class="grid grid-cols-3 gap-2 max-w-[230px] mx-auto mb-4">
        <button data-num="1" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">1</button>
        <button data-num="2" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">2</button>
        <button data-num="3" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">3</button>
        <button data-num="4" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">4</button>
        <button data-num="5" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">5</button>
        <button data-num="6" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">6</button>
        <button data-num="7" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">7</button>
        <button data-num="8" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">8</button>
        <button data-num="9" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">9</button>
        <button id="pass-clear-btn" class="py-2 rounded-xl bg-white/5 hover:bg-white/15 text-[11px] font-semibold text-pink-200 border border-white/10 transition">Xóa</button>
        <button data-num="0" class="num-btn py-2 rounded-xl bg-white/10 hover:bg-pink-500/30 active:scale-95 text-white font-bold text-sm border border-white/10 transition">0</button>
        <button id="pass-del-btn" class="py-2 rounded-xl bg-white/5 hover:bg-white/15 text-pink-200 flex items-center justify-center border border-white/10 transition">
          <i data-lucide="delete" class="w-4 h-4"></i>
        </button>
      </div>

      <button id="start-sky-btn" class="w-full py-3 px-5 rounded-2xl bg-gradient-to-r from-pink-500 via-rose-500 to-amber-500 hover:from-pink-400 hover:to-amber-400 text-white font-bold text-xs sm:text-sm shadow-xl btn-glow transition active:scale-95 flex items-center justify-center gap-2">
        <i data-lucide="wand-sparkles" class="w-4 h-4"></i>
        <span>Bước vào bầu trời sao của Xuka ✨</span>
      </button>
    </div>
  </div>

  <!-- TOP HUD BAR -->
  <header class="relative z-20 px-3 sm:px-6 pt-3 pb-2 flex flex-wrap items-center justify-between gap-2 pointer-events-none">
    <div class="glass-panel rounded-2xl px-3.5 py-2 flex items-center gap-2.5 pointer-events-auto">
      <div class="w-8 h-8 rounded-xl bg-pink-500/20 border border-pink-400/40 flex items-center justify-center text-pink-300 shadow">
        <i data-lucide="globe" class="w-4 h-4"></i>
      </div>
      <div>
        <div class="text-xs sm:text-sm font-bold text-white flex items-center gap-1.5">
          <span>Quả Cầu 3D & Bầu Trời Sao Xuka</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-pink-500/30 text-pink-200 border border-pink-400/30">17/03/2011</span>
        </div>
        <div id="sky-hint-text" class="text-[11px] text-amber-200/90 font-medium">
          👆 Dùng ngón tay / chuột kéo xoay 3D 360° • Chạm vào tấm thẻ trên quả cầu để xem hoặc đổi ảnh của Xuka
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 pointer-events-auto">
      <button id="sphere-mode-btn" class="glass-panel rounded-full px-3 py-1.5 text-xs font-bold text-amber-200 border border-amber-300/50 hover:bg-amber-500/25 transition flex items-center gap-1.5">
        <i data-lucide="globe-2" class="w-3.5 h-3.5 text-amber-300"></i>
        <span id="sphere-mode-label">Quả Cầu Ảnh 3D 🌐</span>
      </button>
      <button id="explode-sphere-btn" class="glass-panel rounded-full px-3 py-1.5 text-xs font-bold text-rose-200 border border-rose-400/50 hover:bg-rose-500/25 transition flex items-center gap-1.5" title="Nổ quả cầu cho ảnh bay lơ lửng 3D">
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-rose-300"></i>
        <span id="explode-label">Tách Thẻ Bay 3D 💥</span>
      </button>
      <button id="galaxy-heart-btn" class="glass-panel rounded-full px-3 py-1.5 text-xs font-bold text-pink-300 border border-pink-400/50 hover:bg-pink-500/25 transition flex items-center gap-1.5">
        <i data-lucide="orbit" class="w-3.5 h-3.5 text-pink-400"></i>
        <span id="galaxy-btn-label">Trái Tim Vũ Trụ 3D 🪐</span>
      </button>
      <button id="upload-photo-btn" class="glass-panel rounded-full px-3 py-1.5 text-xs font-semibold text-emerald-200 border border-emerald-400/40 hover:bg-emerald-500/20 transition flex items-center gap-1.5" title="Thêm ảnh thật của Gia Hân lên Quả Cầu 3D">
        <i data-lucide="image-plus" class="w-3.5 h-3.5 text-emerald-300"></i>
        <span>+ Thêm Ảnh Xuka</span>
      </button>
      <input id="photo-input" type="file" accept="image/*" multiple class="hidden">
      <button id="audio-toggle-btn" class="glass-panel rounded-full px-3 py-1.5 text-xs font-semibold text-slate-200 hover:bg-white/10 transition flex items-center gap-1.5">
        <i data-lucide="volume-2" class="w-3.5 h-3.5 text-pink-300"></i>
        <span id="audio-label">Nhạc: Bật</span>
      </button>
    </div>
  </header>

  <!-- CENTER FLOATING BANNER -->
  <div id="constellation-title-banner" class="relative z-10 text-center pointer-events-none px-4 mt-0.5 transition-all duration-700">
    <div id="pisces-badge" class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-black/70 border border-white/20 text-slate-200 text-[11px] mb-0.5 shadow">
      <span id="star-progress">Đã thắp sáng: 0/7 sao</span>
      <span>•</span>
      <span>♓ Song Ngư 17/03/2011</span>
    </div>
    <h2 id="main-sky-heading" class="font-handwriting text-2xl sm:text-4xl font-bold text-white star-glow">
      Quả Cầu Kỷ Niệm 3D Của Bé Gia Hân ✨
    </h2>
  </div>

  <!-- FLOATING 3D CAMERA ZOOM & ANGLE CONTROLS (Right Side) -->
  <div class="fixed right-3 top-1/2 -translate-y-1/2 z-20 flex flex-col gap-2 pointer-events-auto">
    <button id="zoom-in-btn" class="glass-panel w-10 h-10 rounded-2xl flex items-center justify-center text-white hover:bg-white/15 active:scale-90 transition" title="Phóng to 3D">
      <i data-lucide="zoom-in" class="w-4 h-4"></i>
    </button>
    <button id="zoom-out-btn" class="glass-panel w-10 h-10 rounded-2xl flex items-center justify-center text-white hover:bg-white/15 active:scale-90 transition" title="Thu nhỏ 3D">
      <i data-lucide="zoom-out" class="w-4 h-4"></i>
    </button>
    <button id="auto-rotate-btn" class="glass-panel w-10 h-10 rounded-2xl flex items-center justify-center text-emerald-300 hover:bg-white/15 active:scale-90 transition" title="Bật/Tắt tự xoay 3D">
      <i data-lucide="refresh-cw" class="w-4 h-4"></i>
    </button>
    <button id="center-cam-btn" class="glass-panel w-10 h-10 rounded-2xl flex items-center justify-center text-pink-300 hover:bg-white/15 active:scale-90 transition" title="Đặt lại góc nhìn chính diện">
      <i data-lucide="focus" class="w-4 h-4"></i>
    </button>
    <button id="warp-toggle-btn" class="glass-panel px-2.5 py-2 rounded-2xl flex items-center justify-center gap-1 text-cyan-200 text-[10px] font-semibold hover:bg-white/15 active:scale-90 transition" title="Bay xuyên ngân hà">
      <i data-lucide="rocket" class="w-3.5 h-3.5 text-cyan-300"></i>
      <span id="warp-label">Du Hành 3D</span>
    </button>
    
    <span id="auto-rotate-label" class="hidden">Tự Xoay 3D: Bật</span>
  </div>

  <!-- CARD / STAR DETAIL POPUP MODAL (Shows when tapping a 3D Sphere Card or Star) -->
  <div id="star-card-modal" class="fixed inset-x-0 bottom-20 z-30 flex justify-center px-4 pointer-events-none hidden">
    <div class="glass-panel max-w-md w-full rounded-3xl p-4 sm:p-5 pointer-events-auto border border-pink-400/40 transform transition-all">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span id="card-star-badge" class="w-9 h-9 rounded-2xl bg-gradient-to-br from-pink-500 to-rose-600 text-white font-bold text-sm flex items-center justify-center shadow">
            💖
          </span>
          <div>
            <div id="card-star-subtitle" class="text-[11px] font-semibold uppercase tracking-wider text-pink-300">Kỷ niệm 3D</div>
            <h3 id="card-star-title" class="text-base font-bold text-white">Bé Gia Hân (Xuka) • 17/03/2011</h3>
          </div>
        </div>
        <button id="close-card-btn" class="p-1.5 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 transition">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <p id="card-star-body" class="mt-2.5 text-xs sm:text-sm text-slate-100 leading-relaxed bg-black/60 rounded-2xl p-3.5 border border-white/15"></p>

      <div class="mt-3 flex items-center justify-between gap-2">
        <span id="card-star-quote" class="text-[11px] text-amber-200 italic">✨ Kéo màn hình để xoay quả cầu 360°!</span>
        <button id="next-star-btn" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-pink-500 to-rose-500 text-white text-xs font-semibold shadow hover:opacity-95 active:scale-95 transition">
          Thắp sao tiếp theo →
        </button>
      </div>
    </div>
  </div>

  <!-- FULL LOVE LETTER MODAL -->
  <div id="letter-modal" class="fixed inset-0 z-40 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="glass-panel max-w-lg w-full rounded-3xl p-6 sm:p-8 relative border border-pink-400/40">
      <button id="close-letter-btn" class="absolute top-4 right-4 p-2 rounded-full bg-white/10 text-slate-300 hover:text-white transition">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="flex items-center gap-2 text-amber-200 text-xs font-semibold uppercase tracking-wider mb-1">
        <i data-lucide="sparkles" class="w-4 h-4"></i>
        <span>Lá Thư Từ Quả Cầu Kỷ Niệm 3D</span>
      </div>
      <h3 class="font-handwriting text-3xl sm:text-4xl font-bold text-white star-glow mb-3">
        Gửi Bé Gia Hân (Xuka) Của Anh 💖
      </h3>

      <div class="space-y-3 text-xs sm:text-sm text-slate-200 leading-relaxed bg-black/70 p-4 rounded-2xl border border-white/15 max-h-[55vh] overflow-y-auto">
        <p>
          Chào cô bé cung <strong>Song Ngư sinh ngày 17 tháng 3 năm 2011</strong> của anh! Anh làm món quà <strong>Quả Cầu 3D & Bầu Trời Sao</strong> này dành riêng cho <strong>Bé Gia Hân (Xuka)</strong>.
        </p>
        <p>
          Mỗi tấm thẻ xoay tròn trên quả cầu 3D và mỗi ngôi sao sáng trên bầu trời đêm đều lưu giữ những lời thương yêu anh dành cho em. Dù em có xoay quả cầu đi hướng nào, thì ở tâm điểm vẫn luôn là tình cảm của anh hướng về Xuka.
        </p>
        <p>
          Chúc công chúa nhỏ của anh lúc nào cũng nở nụ cười thật tươi, học giỏi, xinh đẹp và luôn hạnh phúc bên anh nhé!
        </p>
        <div class="pt-2 border-t border-white/15 flex items-center justify-between text-pink-300">
          <span id="days-alive-badge" class="text-xs font-medium">✨ Ngôi sao 17/03/2011</span>
          <span class="font-handwriting text-2xl font-bold text-rose-300">Anh yêu của Xuka ♥</span>
        </div>
      </div>

      <div class="mt-4 flex justify-end gap-2">
        <button id="letter-wish-btn" class="w-full py-3 rounded-2xl bg-gradient-to-r from-pink-500 to-rose-500 text-white text-xs sm:text-sm font-bold shadow-lg active:scale-95 transition">
          Bắn pháo hoa & mưa sao băng chúc Bé Gia Hân 🌠
        </button>
      </div>
    </div>
  </div>

  <!-- BOTTOM CONTROL DOCK -->
  <footer class="relative z-20 px-3 sm:px-6 pb-3.5 pt-1 flex justify-center pointer-events-none">
    <div class="glass-panel rounded-3xl p-2 flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 pointer-events-auto">
      <button id="intro-countdown-btn" class="px-3.5 py-2 rounded-2xl bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-400 hover:to-purple-500 text-white text-xs font-bold shadow flex items-center gap-1.5 active:scale-95 transition" title="Chạy hiệu ứng hạt đếm ngược 3-2-1 như video TikTok DLove">
        <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
        <span>Hiệu Ứng Mở Quà TikTok ✨</span>
      </button>

      <button id="connect-next-btn" class="px-3 py-2 rounded-2xl bg-white/10 hover:bg-white/20 text-pink-200 text-xs font-semibold border border-white/20 flex items-center gap-1.5 active:scale-95 transition">
        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
        <span>Nối Sao Tiếp Theo</span>
      </button>

      <button id="spell-name-btn" class="px-3 py-2 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold border border-white/25 flex items-center gap-1.5 active:scale-95 transition">
        <i data-lucide="heart" class="w-3.5 h-3.5 text-pink-400 fill-pink-400"></i>
        <span id="spell-btn-label">Ghép Chữ: GIA HÂN ♥</span>
      </button>

      <button id="lantern-btn" class="px-3 py-2 rounded-2xl bg-amber-500/90 hover:bg-amber-400 text-slate-950 text-xs font-bold flex items-center gap-1.5 active:scale-95 transition">
        <i data-lucide="flame" class="w-3.5 h-3.5 fill-current"></i>
        <span>Thả Đèn Trời 🏮</span>
      </button>

      <button id="firework-btn" class="px-3 py-2 rounded-2xl bg-rose-500/90 hover:bg-rose-400 text-white text-xs font-bold flex items-center gap-1.5 active:scale-95 transition">
        <i data-lucide="party-popper" class="w-3.5 h-3.5"></i>
        <span>Pháo Hoa Tim 🎆</span>
      </button>

      <button id="meteor-shower-btn" class="px-3 py-2 rounded-2xl bg-white/10 hover:bg-white/20 text-amber-200 text-xs font-semibold border border-white/20 flex items-center gap-1.5 active:scale-95 transition">
        <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-300"></i>
        <span>Mưa Sao Băng 🌠</span>
      </button>

      <button id="open-letter-btn" class="px-3 py-2 rounded-2xl bg-pink-500/30 hover:bg-pink-500/45 text-pink-100 text-xs font-bold border border-pink-400/50 flex items-center gap-1.5 active:scale-95 transition">
        <i data-lucide="mail-heart" class="w-3.5 h-3.5 text-pink-300"></i>
        <span>Thư Ánh Sao 💌</span>
      </button>

      <button id="reset-sky-btn" class="px-2.5 py-2 rounded-2xl bg-white/5 hover:bg-white/15 text-slate-300 text-xs font-medium flex items-center gap-1 active:scale-95 transition" title="Làm mới">
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
      </button>
    </div>
  </footer>

  <!-- Toast Banner -->
  <div id="toast" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 hidden glass-panel px-4 py-2 rounded-full text-xs font-semibold text-white border border-white/30 shadow-xl">
    <span id="toast-text">✨</span>
  </div>

  <script>
    lucide.createIcons();

    // --- Calculate days since 17/03/2011 ---
    const birthDate = new Date(2011, 2, 17);
    const nowDate = new Date();
    const daysSinceBirth = Math.max(1, Math.floor((nowDate - birthDate) / (1000 * 60 * 60 * 24)));
    document.getElementById('days-alive-badge').textContent = `✨ Đã tỏa sáng ${daysSinceBirth.toLocaleString('vi-VN')} ngày kể từ 17/03/2011`;

    // --- Web Audio API Romantic Melody & Chimes ---
    let audioCtx = null;
    let soundOn = true;
    let melodyTimer = null;

    function ensureAudio() {
      if (!audioCtx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (AC) audioCtx = new AC();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playStarChime(stepIndex = 0, dur = 0.75) {
      if (!soundOn) return;
      ensureAudio();
      if (!audioCtx) return;
      const scale = [523.25, 587.33, 659.25, 783.99, 880.0, 1046.5, 1174.66, 1318.5, 1567.98];
      const freq = scale[stepIndex % scale.length];

      const osc = audioCtx.createOscillator();
      const osc2 = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = 'sine';
      osc2.type = 'triangle';
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      osc2.frequency.setValueAtTime(freq * 1.5, audioCtx.currentTime);

      gain.gain.setValueAtTime(0.065, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0008, audioCtx.currentTime + dur);

      osc.connect(gain);
      osc2.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc2.start();
      osc.stop(audioCtx.currentTime + dur);
      osc2.stop(audioCtx.currentTime + dur);
    }

    function playMagicChord() {
      if (!soundOn) return;
      [523.25, 659.25, 783.99, 1046.5, 1318.5].forEach((f, i) => {
        setTimeout(() => playStarChime(i + 2, 0.9), i * 75);
      });
    }

    // Gentle music box background loop
    const musicBoxNotes = [5, 4, 2, 0, 2, 4, 5, 7, 6, 4, 2, 4, 5];
    let noteCursor = 0;
    function startMusicBoxLoop() {
      if (melodyTimer) clearInterval(melodyTimer);
      melodyTimer = setInterval(() => {
        if (soundOn && document.getElementById('intro-modal').classList.contains('hidden')) {
          playStarChime(musicBoxNotes[noteCursor % musicBoxNotes.length], 1.1);
          noteCursor++;
        }
      }, 950);
    }

    // --- Toast Helper ---
    let toastTimeout = null;
    function showToast(msg) {
      const t = document.getElementById('toast');
      document.getElementById('toast-text').textContent = msg;
      t.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => t.classList.add('hidden'), 3200);
    }

    // --- Passcode Input (1703) ---
    let enteredPin = '';
    function updatePinDots() {
      for (let i = 0; i < 4; i++) {
        const dot = document.getElementById(`dot-${i}`);
        if (i < enteredPin.length) {
          dot.classList.add('bg-pink-400', 'scale-110');
        } else {
          dot.classList.remove('bg-pink-400', 'scale-110');
        }
      }
      document.getElementById('pass-hint').classList.add('opacity-0');
    }

    document.querySelectorAll('.num-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        playStarChime(enteredPin.length + 1, 0.3);
        if (enteredPin.length < 4) {
          enteredPin += btn.getAttribute('data-num');
          updatePinDots();
          if (enteredPin.length === 4) {
            if (enteredPin === '1703') {
              launchGiftExperience();
            } else {
              document.getElementById('pass-hint').classList.remove('opacity-0');
              setTimeout(() => {
                enteredPin = '';
                updatePinDots();
              }, 700);
            }
          }
        }
      });
    });

    document.getElementById('pass-clear-btn').addEventListener('click', () => {
      enteredPin = '';
      updatePinDots();
    });

    document.getElementById('pass-del-btn').addEventListener('click', () => {
      enteredPin = enteredPin.slice(0, -1);
      updatePinDots();
    });

